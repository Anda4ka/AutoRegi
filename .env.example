# Copy to .env and fill in. Then: chmod 600 .env proxy.txt message.txt active_subscribers.txt

BOT_TOKEN=123456789:AA...your_token_from_BotFather

# Required for /admin (empty = fail-closed, no admin access)
ADMIN_IDS=123456789
# ALLOW_OPEN_ADMIN=1

# Optional "paid private group" upsell (/priv screen + button). The bot never
# charges; it only links to this Telegram bot and reads group membership.
# Empty = the whole feature is hidden.
# UPSELL_BOT=YourUpsellBot

# Shared proxies
# PROXY_FILE=proxy.txt
# EXTRA_PROXY_FILES=message.txt

# Persistent runtime state. Keep it OUTSIDE the Git checkout so clean
# deploys do not lose wallets, DB history, proxies or queued payloads.
# Default without this variable: ~/.autoreg
# AUTOREG_STATE_DIR=/root/.autoreg
# AUTOREG_MIGRATE_LEGACY=1
#
# Optional per-path overrides (relative values resolve from the checkout):
# BOT_DB=/root/.autoreg/tgbot.db
# BOT_RESULTS=/root/.autoreg/bot_results.jsonl
# USER_PROXY_DIR=/root/.autoreg/user_proxies
# USER_DATA_DIR=/root/.autoreg/user_data
# JOB_PAYLOAD_DIR=/root/.autoreg/job_payloads

# Tiered OK limits (gate). Runtime free: /set_free_limit (SQLite).
# FREE_OK_LIMIT=10
# Capsolver key — only for sites that verify their Turnstile token.
# CAPSOLVER_API_KEY=CAP-...
# USER_MAX_ACTIVE_JOBS=3
# VIP_MAX_ACTIVE_JOBS=0   # VIP «all projects» queue depth; 0 = auto (project count)
# VIP_JOB_PARALLEL=20      # rows in flight inside one VIP job
# VIP_PARALLEL_JOBS=20     # VIP jobs (projects) running at once; 0 = Basic's + 1
# BASE_JOB_PARALLEL=5      # same for the unpaid tiers (Basic stays above it)
# GLOBAL_REQUESTS_PER_MINUTE=2000   # global cap; raise this with the thread counts or nothing changes
# SUBSCRIBERS_FILE=active_subscribers.txt
# SUBSCRIBER_OK_LIMIT=50   # code default is 100
# Group whose members get that same limit automatically, with no file to edit
# (bot/group_tier.py, getChatMember — the bot must be an ADMIN of the group).
# Empty = off. Accepts -100… id or @username.
# SUBSCRIBER_GROUP=-1001234567890
# SUBSCRIBER_GROUP_OK_LIMIT=0   # 0 = follow SUBSCRIBER_OK_LIMIT
# The two subscriber sources ADD UP: in the file AND in the group = 50 + 50.
# GROUP_MEMBER_TTL=600          # seconds a "member" answer is trusted
# GROUP_NONMEMBER_TTL=30        # seconds a "not a member" answer is trusted
# VIP hardcode is empty by default; seed entries without touching code here.
# USER_OK_LIMITS=111111111:500

# Own /proxy upload caps
# USER_PROXY_MAX_LINES=1000
# USER_PROXY_MAX_BYTES=524288

# Bulk data .txt: min(remaining, lines_by_tier)
# unpaid-tier defaults; VIP uses VIP caps (match ~1000 OK slots)
# BULK_MAX_LINES=100
# BULK_MAX_BYTES=102400
# BULK_VIP_MAX_LINES=1000
# BULK_VIP_MAX_BYTES=524288

# Alerts / digest
# ADMIN_DIGEST=1
# ADMIN_FAIL_ALERT_THRESHOLD=20
# ADMIN_ALERT_INTERVAL=300

# New-project alert (bot/new_project_alert.py). Admins approve every send;
# 0 = off entirely, and ids added while off are absorbed, not queued up.
# NEW_PROJECT_ALERTS=1
# NEW_PROJECT_ALERT_INTERVAL=10      # seconds between recipients (VIP first)
# NEW_PROJECT_ALERT_ACTIVE_DAYS=30   # audience: users who submitted this recently

# Broadcast outbox (bot/broadcast.py). The floor is bot-wide and is what keeps
# a fast manual broadcast under Telegram's rate limit; the drip above is
# per-batch and about the project's own intake, not Telegram.
# BROADCAST_MIN_INTERVAL=0.05        # ~20 msg/s ceiling across all batches
# BROADCAST_MAX_ATTEMPTS=5
# BROADCAST_RETRY_BASE=5
# BROADCAST_RETRY_CAP=300
# BROADCAST_IDLE_SLEEP=2

# BOT_MIN_DELAY=1
# BOT_MAX_DELAY=2.5
# BOT_RETRIES=8
# BOT_RETRY_DELAY=10
# BOT_CONCURRENCY=10
# BOT_HANDLER_THREADS=10

# Channel gate (bot must be admin of the channel). Empty REQUIRED_CHANNEL
# disables the gate.
# REQUIRE_CHANNEL=1
# REQUIRED_CHANNEL=@your_channel
# REQUIRED_CHANNEL_URL=https://t.me/your_channel
# REQUIRED_CHANNEL_TITLE=Your Channel

# Captcha solvers — for a route whose Turnstile is verified server-side. The
# rule: solve through the very proxy the row will be submitted from, or the
# token is refused.
# CAPSOLVER_API_KEY=
# TWOCAPTCHA_API_KEY=

# LLM for auto blurbs
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Mini App (webapp/) — public https URL. Empty hides the button entirely and
# the bot behaves exactly as it did before the prototype. See ops/CLOUDFLARE.md.
# WEBAPP_URL=https://app.example.com

# ONE python tgbot.py per BOT_TOKEN (see ops/README.md)
